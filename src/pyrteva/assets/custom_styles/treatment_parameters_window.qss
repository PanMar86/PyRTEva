/* Custom stylesheet */

QDialog {background-color: #1E1E2F; border-style: solid; border-color:  #6B6F83; border-width: 2px; border-radius: 6px}

QGroupBox#treatment_parameters_outer_container {border-style: solid; border-color:  #6B6F83; border-width: 2px; border-radius: 6px; font-size: 12px}
QGroupBox#treatment_parameters_outer_container QLabel {font-size: 14px}

QWidget#treatment_parameters_inner_container {background-color: black; border-style: solid; border-color: silver; border-width: 1px; border-radius: 6px}
QWidget#treatment_parameters_inner_container QLabel {min-width: 180px; max-width: 180px; font-size: 14px}
QWidget#treatment_parameters_inner_container QComboBox {background-color: #6B6F83; min-width: 120px; max-width: 120px; min-height: 25px; max-height: 25px; font-size: 14px}

QPushButton#apply_button {background-color: #3B3F58; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px; border-radius: 6px; min-width: 80px; max-width: 80px; min-height: 25px; max-height: 25px; font-size: 14px}
QPushButton#apply_button:hover {border-color: #B5B5BA}
QPushButton#apply_button:pressed {border-color: #6B6F83}