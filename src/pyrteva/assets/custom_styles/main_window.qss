/* Custom stylesheet */

QWidget#main_window {background-color: #1E1E2F; border-style: solid; border-color: #6B6F83; border-width: 2px; border-radius: 6px}
QWidget#main_window > QWidget {background-color: black; border-style: solid; border-color: #6B6F83; border-width: 2px; border-radius: 6px}
QWidget#main_window > QWidget QLabel {color: #E8E8F0; font-size: 18px}

QWidget#buttonBar QPushButton {background-color: #3B3F58; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px; border-radius: 2px;
                               min-width: 200px; max-width: 200px; min-height: 30px; max-height: 30px; font-size: 14px}
QWidget#buttonBar QPushButton:hover {border-color: #B5B5BA}
QWidget#buttonBar QPushButton:pressed {border-color: #6B6F83}

QGroupBox#dvh_control_panel {border: none; min-width: 170px; max-width: 170px}

QScrollArea#dvh_buttons_scrollable_area {border-style: solid; border-color: silver; border-width: 1px; border-radius: 6px}

QGroupBox#dvh_buttons {border: none}
QGroupBox#dvh_buttons QPushButton {background-color: #3B3F58; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px; border-radius: 2px;
                                   min-width: 130px; max-width: 130px; min-height: 20px; max-height: 20px; font-size: 14px}
QGroupBox#dvh_buttons QPushButton:hover {border-color: #B5B5BA}
QGroupBox#dvh_buttons QPushButton:pressed {border-color: #6B6F83}

QStatusBar {color: #E8E8F0; border: none; font-size: 14px}

QTabWidget::pane {background-color: black; border-style: solid; border-color: silver; border-width: 1px; border-radius: 6px; margin-top: 3px}

QHeaderView {background-color: black}
QHeaderView::section:horizontal {background-color: #7D510B; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px}
QHeaderView::section:vertical {background-color: black; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px}

QTabBar::tab {background-color: #3B3F58; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px; border-radius: 2px;
              margin-right: 5px; min-width: 180px; max-width: 180px; min-height: 24px; max-height: 24px; font-size: 14px}
QTabBar::tab:hover {border-color: #B5B5BA}
QTabBar::tab:selected {border-color: #B5B5BA}

QTableWidget {background-color: black; gridline-color: #6B6F83; color: #E8E8F0; font-size: 15px}

QToolTip {background-color: #3B3F58; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px; border-radius: 2px;
          padding: 2px; font-size: 14px}

QToolButton {background-color: #3B3F58; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px; border-radius: 2px;
                               min-width: 200px; max-width: 200px; min-height: 30px; max-height: 30px; font-size: 14px;}
QToolButton::menu-indicator {image: none}
QToolButton:hover {border-color: #B5B5BA}
QToolButton:pressed {border-color: #6B6F83}

QMenu {border: none}
QMenu::item {background-color: #3B3F58; color: #E8E8F0; border-style: solid; border-color: #6B6F83; border-width: 1px; border-radius: 2px;
             padding-left: 25px; padding-top: 5px; padding-bottom: 5px; min-width: 175px; max-width: 175px; font-size: 14px}
QMenu::item:selected {border-color: #B5B5BA}
QMenu::item:pressed {border-color: #6B6F83}